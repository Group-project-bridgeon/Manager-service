              "mode": "raw",
              "raw": "{\n  \"service\": \"purchasing\",\n  \"resource_id\": \"PO-MULTI-{{$timestamp}}\",\n  \"amount\": 85000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/approvals/submit",
              "host": [
