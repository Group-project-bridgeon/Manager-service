# Application Environment (development, staging, production)
APP_ENV=development

# Server Port (1-65535)
PORT=8080

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Server Timeouts (Go duration format: 5s, 10s, 1m)
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=5s
