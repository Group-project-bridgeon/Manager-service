                  "var jsonData = pm.response.json();",
                  "pm.test(\"Error code is DUPLICATE_SUBMISSION or REQUEST_ALREADY_DECIDED\", function () {",
                  "    pm.expect([\"DUPLICATE_SUBMISSION\", \"REQUEST_ALREADY_DECIDED\"]).to.include(jsonData.error.code);",
                  "});"
                ]
              }
            }
          ]
        },
