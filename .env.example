# Application Environment (development, staging, production)
APP_ENV=development

# Server Port (1-65535)
PORT=8080

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Server Timeouts (Go duration format: 5s, 10s, 1m)
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=5s

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password_change_in_production
DB_NAME=erp_manager
DB_SSLMODE=disable

# Database Connection Pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# JWT Authentication Configuration (RS256 Public Key)
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=erp-auth
JWT_AUDIENCE=erp-api
